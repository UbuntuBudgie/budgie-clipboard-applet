#: src/ClipboardManagerApplet.vala:76
msgid "Welcome to Clipboard Manager"
msgstr "La benvenguda al gestionari de quichapapièrs"

#: src/ClipboardManagerApplet.vala:76
msgid "Your Clips will be saved Automatically"
msgstr "Çò que copiatz serà automaticament salvat"

#: src/ClipboardManagerApplet.vala:146
msgid "History Size"
msgstr "Talha de l'istoric"

#: src/ClipboardManagerApplet.vala:155
msgid "Get Selection to Clipboard"
msgstr "Obténer la seleccionat dins lo quichapapièr"

#: src/ClipboardManagerApplet.vala:164
msgid "Copy Selection to Clipboard"
msgstr "Copiar lo tèxte seleccionat dins lo quichapapièr"

#: src/ClipboardManagerApplet.vala:179
msgid "Case Sensitive Search"
msgstr "Recèrca amb sensibilitat a la cassa"

#: src/ClipboardManagerApplet.vala:189
msgid "Save History to File"
msgstr "Enregistrar l’istoric dins un fichièr"

#: src/ClipboardManagerApplet.vala:198
msgid "Paste after Clicking (Requires xdotool)"
msgstr "Pegar aprèp un clic (Requerís xdotool)"

#: src/ClipboardManagerApplet.vala:199
msgid "Clipboard Height"
msgstr "Nautor del quichapapièrs"

#: src/ClipboardManagerApplet.vala:208
msgid "Restore Defaults"
msgstr "Restaurar las valors per defaut"

#: src/ClipboardManagerApplet.vala:373
msgid "Clear All"
msgstr "Tot escafar"

#: src/ClipboardManagerApplet.vala:382
msgid "Private Mode"
msgstr "Mòde privat"

#: src/ClipboardManagerApplet.vala:403
msgid "Enabling this will stop Clipboard Manager to save any Clips"
msgstr "Activar aquò empacharà lo gestionari de quichapapièrs d’enregistrar que que siá"

#: src/ClipboardManagerApplet.vala:409
msgid "Notifications"
msgstr "Notificacions"

#: src/ClipboardManagerApplet.vala:424
msgid "Enabling this will Notify you about every clips you copy"
msgstr "Activar aquò vos notificarà per cada fragment que copiatz"

#: src/ClipboardManagerApplet.vala:429
msgid "Search Clipboard History"
msgstr "Cercar dins l’istoric del quichapapièrs"

#: src/ClipboardManagerApplet.vala:629
msgid "No Clipboard Items Found"
msgstr "Cap d’element de quichapapièrs pas trobat"

#: src/ClipboardManagerApplet.vala:629
msgid "Try changing search terms"
msgstr "Ensajatz de cambiar los tèrmes de recèrca"

#: src/ClipboardManagerApplet.vala:675
msgid "Copied"
msgstr "Copiat"
